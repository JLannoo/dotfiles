#!/usr/bin/bash

CONTAINER_NAME="php-server"

VERSION="8.4"
PORT="8080"

EXTENSIONS="mysqli pdo pdo_mysql"
MODULES="rewrite"

# get script flags
while getopts v:p flag;
  do
    case "${flag}" in
      v) VERSION="$OPTARG" ;;
      p) PORT="$OPTARG" ;;
    esac
done

VERSION_STRING="${VERSION}-apache"
PREP_COMMANDS="a2enmod ${MODULES} && docker-php-ext-install ${EXTENSIONS}"

cleanup() {
  docker kill "${CONTAINER_NAME}" > /dev/null 2>&1 || true
}

# Kill the container when the script is interrupted or exits
trap cleanup INT TERM EXIT

echo -e "\e[33mPrepping with modules: ${MODULES} and extensions: ${EXTENSIONS} \e[0m"
docker run -d --rm --add-host=host.docker.internal:host-gateway \
  -v $(pwd):/var/www/html/ \
  -p ${PORT}:80 \
  --name "${CONTAINER_NAME}" \
  php:${VERSION_STRING} \
  tail -f /dev/null > /dev/null

docker exec "${CONTAINER_NAME}" bash -lc "${PREP_COMMANDS}" > /dev/null 2>&1

echo -e "\e[32mPHP Server started at http://localhost:${PORT} \e[0m"
docker exec -i "${CONTAINER_NAME}" bash -lc "apache2-foreground"
